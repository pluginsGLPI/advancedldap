<div class="card">
    <div class="card-header d-flex align-items-center">
        <h3 class="me-auto">
            <i class="ti ti-filter me-2"></i>
            {{ __('Sync Filters for', 'advancedldap') }} {{ authldap.fields['name'] }}
        </h3>
        {% if can_edit %}
            <div class="ms-auto">
                <a href="{{ config('root_doc') }}/plugins/advancedldap/front/syncfilter.form.php?authldap_id={{ authldap.getID() }}" 
                   class="btn btn-primary">
                    <i class="ti ti-plus me-1"></i>
                    {{ __('Add Sync Filter', 'advancedldap') }}
                </a>
                <a href="{{ config('root_doc') }}/plugins/advancedldap/front/syncfilter.php" 
                   class="btn btn-outline-secondary">
                    <i class="ti ti-list me-1"></i>
                    {{ __('Manage All Filters', 'advancedldap') }}
                </a>
            </div>
        {% endif %}
    </div>
    <div class="card-body">
        {% if sync_filters|length > 0 %}
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th width="20"></th>
                            <th>{{ __('Name') }}</th>
                            <th>{{ __('Base DN', 'advancedldap') }}</th>
                            <th>{{ __('LDAP Filter', 'advancedldap') }}</th>
                            <th>{{ __('Asset Type', 'advancedldap') }}</th>
                            <th>{{ __('Status', 'advancedldap') }}</th>
                            <th>{{ __('Actions') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for filter in sync_filters %}
                            <tr>
                                <td>
                                    {% if filter.is_active %}
                                        <i class="ti ti-circle-check text-success" title="{{ __('Active') }}"></i>
                                    {% else %}
                                        <i class="ti ti-circle-x text-danger" title="{{ __('Inactive') }}"></i>
                                    {% endif %}
                                </td>
                                <td>
                                    <strong>{{ filter.name }}</strong>
                                </td>
                                <td>
                                    <code class="small">{{ filter.base_dn }}</code>
                                </td>
                                <td>
                                    <code class="small">{{ filter.ldap_filter|length > 50 ? filter.ldap_filter|slice(0, 50) ~ '...' : filter.ldap_filter }}</code>
                                </td>
                                <td>
                                    <span class="badge bg-info">{{ filter.asset_type }}</span>
                                </td>
                                <td>
                                    {% if filter.is_active %}
                                        <span class="badge bg-success">{{ __('Active') }}</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ __('Inactive') }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ config('root_doc') }}/plugins/advancedldap/front/syncfilter.form.php?id={{ filter.id }}" 
                                           class="btn btn-sm btn-outline-primary" title="{{ __('Edit') }}">
                                            <i class="ti ti-edit"></i>
                                        </a>
                                        {% if can_edit %}
                                            <a href="{{ config('root_doc') }}/plugins/advancedldap/front/syncfilter.form.php?id={{ filter.id }}&test_ldap=1&test_authldap_id={{ authldap.getID() }}&test_base_dn={{ filter.base_dn|url_encode }}&test_filter={{ filter.ldap_filter|url_encode }}&test_asset_type={{ filter.asset_type|url_encode }}" 
                                               class="btn btn-sm btn-outline-info" title="{{ __('Test Filter', 'advancedldap') }}">
                                                <i class="ti ti-flask"></i>
                                            </a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% else %}
            <div class="alert alert-info d-flex align-items-center">
                <i class="ti ti-info-circle me-3 fa-2x"></i>
                <div>
                    <h4>{{ __('No sync filters configured', 'advancedldap') }}</h4>
                    <p class="mb-0">
                        {{ __('Create your first sync filter to start synchronizing LDAP data with GLPI assets.', 'advancedldap') }}
                    </p>
                    {% if can_edit %}
                        <a href="{{ config('root_doc') }}/plugins/advancedldap/front/syncfilter.form.php?authldap_id={{ authldap.getID() }}" 
                           class="btn btn-primary mt-2">
                            <i class="ti ti-plus me-1"></i>
                            {{ __('Create First Filter', 'advancedldap') }}
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
</div>

{% if sync_filters|length > 0 %}
    <div class="card mt-3">
        <div class="card-header">
            <h4>
                <i class="ti ti-info-circle me-2"></i>
                {{ __('About Sync Filters', 'advancedldap') }}
            </h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5>{{ __('What are sync filters?', 'advancedldap') }}</h5>
                    <p>{{ __('Sync filters allow you to define which LDAP entries should be synchronized with specific GLPI asset types. Each filter can target different organizational units and object classes in your LDAP directory.', 'advancedldap') }}</p>
                </div>
                <div class="col-md-6">
                    <h5>{{ __('Filter Status', 'advancedldap') }}</h5>
                    <ul class="list-unstyled">
                        <li><i class="ti ti-circle-check text-success me-1"></i> {{ __('Active filters will be used during synchronization', 'advancedldap') }}</li>
                        <li><i class="ti ti-circle-x text-danger me-1"></i> {{ __('Inactive filters are ignored during synchronization', 'advancedldap') }}</li>
                        <li><i class="ti ti-flask text-info me-1"></i> {{ __('Use the test function to validate filters before activation', 'advancedldap') }}</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endif %}