{% import "components/form/fields_macros.html.twig" as fields %}

<form method="post" action="../plugins/advancedldap/front/config.form.php">
<div class="card">
    <div class="card-header">
        <h3>{{ __('Asset Type Selection') }}</h3>
    </div>
    <div class="card-body">
        <!-- Première rangée : Base DN et LDAP Connection Filter -->
        <div class="row">
            <div class="col-md-6">
                <div class="form-field mb-3">
                    <label class="form-label"><i class="ti ti-database me-1"></i>{{ __('Base DN', 'advancedldap') }}</label>
                    <input type="text" name="ldap_base_dn" class="form-control" 
                           value="{{ current_config.ldap_base_dn|default('') }}" 
                           placeholder="ou=users,dc=example,dc=com">
                    <div class="form-text">{{ __('Base Distinguished Name for LDAP synchronization (e.g., ou=users,dc=example,dc=com)', 'advancedldap') }}</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-field mb-3">
                    <label class="form-label"><i class="ti ti-filter me-1"></i>{{ __('LDAP Connection Filter', 'advancedldap') }}</label>
                    <input type="text" name="ldap_connection_filter" class="form-control" 
                           value="{{ current_config.ldap_connection_filter|default('') }}" 
                           placeholder="objectClass=user">
                    <div class="form-text">{{ __('LDAP filter for synchronization (e.g., objectClass=user, objectClass=group)', 'advancedldap') }}</div>
                </div>
            </div>
        </div>
        
        <!-- Seconde rangée : Asset Type et Asset Field -->
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="form-field mb-3">
                    <label class="form-label"><i class="ti ti-package me-1"></i>{{ __('Asset Type') }}</label>
                    {% set asset_type_rand = random() %}
                    <select name="asset_type" id="dropdown_asset_type{{ asset_type_rand }}" class="form-select">
                        <option value="">{{ __('Select an asset type') }}</option>
                        {% for key, value in available_assets %}
                            {% if key in ['native_separator', 'generic_separator'] %}
                                <option disabled>{{ value }}</option>
                            {% else %}
                                <option value="{{ key }}">{{ value }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-field mb-3">
                    <label class="form-label"><i class="ti ti-input-search me-1"></i>{{ __('Asset Field', 'advancedldap') }}</label>
                    {% set asset_field_rand = asset_type_rand %}
                    <div id="asset_field_dropdown_{{ asset_field_rand }}">
                        <select name="asset_field" class="form-select" disabled>
                            <option value="">{{ __('Select an asset type first', 'advancedldap') }}</option>
                        </select>
                    </div>
                    <div class="form-text">{{ __('Select which field of the asset to map with LDAP', 'advancedldap') }}</div>
                </div>
            </div>
        </div>
        
        <hr>
        
        {{ fields.sliderField('show_inactive_generic_assets', current_config.show_inactive_generic_assets|default(0), __('Show inactive generic assets', 'advancedldap'), {
            'helper': __('Include generic assets with is_active = 0 in the selection', 'advancedldap')
        }) }}
        
        {% if can_edit %}
            <div class="text-center mt-3">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="authldap_id" value="{{ authldap.getID() }}">
                <button type="submit" name="update_config" class="btn btn-primary">
                    <i class="fas fa-save"></i>
                    {{ __('Update', 'advancedldap') }}
                </button>
            </div>
        {% endif %}
    </div>
</div>
</form>

<script type="text/javascript">
$(document).ready(function() {
    $('#dropdown_asset_type{{ asset_type_rand }}').on('change', function() {
        var itemtype = $(this).val();
        var container = $('#asset_field_dropdown_{{ asset_field_rand }}');
        
        console.log('Asset type changed to:', itemtype);
        
        if (!itemtype || itemtype === '0' || itemtype === '') {
            container.html('<select name="asset_field" class="form-select" disabled><option value="">Select an asset type first</option></select>');
            return;
        }
        
        container.html('<select name="asset_field" class="form-select" disabled><option>Loading fields...</option></select>');
        
        $.post('{{ config('root_doc') }}/plugins/advancedldap/ajax/getAssetFields.php', {
            itemtype: itemtype,
            name: 'asset_field',
            rand: {{ asset_field_rand }}
        })
        .done(function(data) {
            console.log('AJAX success, data length:', data.length);
            container.html(data);
        })
        .fail(function(xhr, status, error) {
            console.log('AJAX failed:', status, error);
            container.html('<select name="asset_field" class="form-select" disabled><option>Error loading fields</option></select>');
        });
    });
});
</script>