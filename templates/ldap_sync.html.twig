{% import "components/form/fields_macros.html.twig" as fields %}

<form method="post" action="../plugins/advancedldap/front/config.form.php">
<div class="card">
    <div class="card-header">
        <h3>{{ __('Asset Type Selection') }}</h3>
    </div>
    <div class="card-body">
        {{ fields.dropdownArrayField('asset_type', '', available_assets, __('Asset Type'), {
            'width': '300px',
            'disabled_values': ['native_separator', 'generic_separator']
        }) }}
        
        {{ fields.textField('ldap_connection_filter', current_config.ldap_connection_filter|default(''), __('LDAP Connection Filter', 'advancedldap'), {
            'helper': __('LDAP filter for synchronization (e.g., objectClass=user, objectClass=group)', 'advancedldap'),
            'placeholder': 'objectClass=user'
        }) }}
        
        {{ fields.textField('ldap_base_dn', current_config.ldap_base_dn|default(''), __('Base DN', 'advancedldap'), {
            'helper': __('Base Distinguished Name for LDAP synchronization (e.g., ou=users,dc=example,dc=com)', 'advancedldap'),
            'placeholder': 'ou=users,dc=example,dc=com'
        }) }}
        
        <hr>
        
        {{ fields.sliderField('show_inactive_generic_assets', current_config.show_inactive_generic_assets|default(0), __('Show inactive generic assets', 'advancedldap'), {
            'helper': __('Include generic assets with is_active = 0 in the selection', 'advancedldap')
        }) }}
        
        {% if can_edit %}
            <div class="text-center mt-3">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="authldap_id" value="{{ authldap.getID() }}">
                <button type="submit" name="update_config" class="btn btn-primary">
                    <i class="fas fa-save"></i>
                    {{ __('Update', 'advancedldap') }}
                </button>
            </div>
        {% endif %}
    </div>
</div>
</form>