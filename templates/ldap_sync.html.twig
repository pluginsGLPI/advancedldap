{% import "components/form/fields_macros.html.twig" as fields %}

<div class="container-fluid">
    <div class="card mb-4">
        <div class="card-header">
            <h3><i class="ti ti-database-sync"></i> {{ __('Advanced LDAP Synchronization Configuration', 'advancedldap') }}</h3>
        </div>
        <div class="card-body">
            {% if can_edit %}
                <form name="form" action="{{ path('front/plugin_advancedldap.form.php') }}" method="POST">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="authldaps_id" value="{{ authldap.fields['id'] }}">
                    
                    <div class="row">
                        <div class="col-md-6">
                            {{ fields.dropdownYesNo('is_active', current_config['is_active'] ?? 0, __('Enable advanced sync', 'advancedldap')) }}
                        </div>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary mx-1" name="update_config" value="1">
                            <i class="ti ti-device-floppy"></i>
                            <span>{{ _x('button', 'Save') }}</span>
                        </button>
                    </div>
                </form>
            {% else %}
                <div class="row">
                    <div class="col-md-6">
                        {{ fields.readOnlyField(__('Enable advanced sync', 'advancedldap'), current_config['is_active'] ? __('Yes') : __('No')) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    {# SYNCHRONIZABLE ELEMENTS SECTION #}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3><i class="ti ti-list"></i> {{ __('Synchronizable Elements', 'advancedldap') }}</h3>
            {% if can_edit %}
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addElementModal">
                    <i class="ti ti-plus"></i> {{ __('Add element type', 'advancedldap') }}
                </button>
            {% endif %}
        </div>
        <div class="card-body">
            {% if sync_elements|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>{{ __('Name') }}</th>
                                <th>{{ __('Item type', 'advancedldap') }}</th>
                                <th>{{ __('Active') }}</th>
                                <th>{{ __('LDAP Filter', 'advancedldap') }}</th>
                                <th>{{ __('Base DN', 'advancedldap') }}</th>
                                <th>{{ __('Actions') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for element in sync_elements %}
                            <tr>
                                <td>{{ element.name }}</td>
                                <td>{{ element.itemtype }}</td>
                                <td>
                                    {% if element.is_active %}
                                        <i class="ti ti-check text-success"></i>
                                    {% else %}
                                        <i class="ti ti-x text-danger"></i>
                                    {% endif %}
                                </td>
                                <td>
                                    <code>{{ element.ldap_filter|slice(0, 50) }}{% if element.ldap_filter|length > 50 %}...{% endif %}</code>
                                </td>
                                <td><small>{{ element.base_dn }}</small></td>
                                <td>
                                    {% if can_edit %}
                                        <button type="button" class="btn btn-sm btn-outline-primary" 
                                                onclick="editElement({{ element.id }})">
                                            <i class="ti ti-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                onclick="deleteElement({{ element.id }})">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="text-center text-muted py-4">
                    <i class="ti ti-database-off fa-2x mb-2"></i>
                    <p>{{ __('No synchronizable elements configured', 'advancedldap') }}</p>
                    {% if can_edit %}
                        <small>{{ __('Click "Add element type" to configure your first synchronizable element', 'advancedldap') }}</small>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</div>

{# ADD/EDIT ELEMENT MODAL #}
{% if can_edit %}
<div class="modal fade" id="addElementModal" tabindex="-1" aria-labelledby="addElementModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addElementModalLabel">{{ __('Add Synchronizable Element', 'advancedldap') }}</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="POST" action="{{ path('front/plugin_advancedldap.form.php') }}" id="elementForm">
                <div class="modal-body">
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="authldaps_id" value="{{ authldap.fields['id'] }}">
                    <input type="hidden" name="id" value="" id="element_id">
                    
                    <div class="row">
                        <div class="col-md-6">
                            {{ fields.textField('name', '', __('Name'), {required: true}) }}
                        </div>
                        <div class="col-md-6">
                            {{ fields.dropdownYesNo('is_active', 1, __('Active')) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12">
                            {{ fields.dropdownField('dropdown', 'itemtype', '', __('Item type', 'advancedldap'), {required: true}) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12">
                            {{ fields.textareaField('ldap_filter', '', __('LDAP Filter', 'advancedldap'), {
                                placeholder: '(objectClass=*)',
                                rows: 3
                            }) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-12">
                            {{ fields.textField('base_dn', '', __('Base DN', 'advancedldap'), {
                                placeholder: 'ou=people,dc=example,dc=com'
                            }) }}
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ __('Cancel') }}</button>
                    <button type="submit" name="add_element" class="btn btn-primary">{{ __('Save') }}</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endif %}

<script>
function editElement(id) {
    // Load element data and populate modal for editing
    // This would be implemented with AJAX call to load element data
    console.log('Edit element:', id);
}

function deleteElement(id) {
    if (confirm('{{ __('Are you sure you want to delete this element?', 'advancedldap') }}')) {
        // Submit delete form
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '{{ path('front/plugin_advancedldap.form.php') }}';
        
        const csrfField = document.createElement('input');
        csrfField.type = 'hidden';
        csrfField.name = '_glpi_csrf_token';
        csrfField.value = '{{ csrf_token() }}';
        form.appendChild(csrfField);
        
        const idField = document.createElement('input');
        idField.type = 'hidden';
        idField.name = 'id';
        idField.value = id;
        form.appendChild(idField);
        
        const actionField = document.createElement('input');
        actionField.type = 'hidden';
        actionField.name = 'delete_element';
        actionField.value = '1';
        form.appendChild(actionField);
        
        document.body.appendChild(form);
        form.submit();
    }
}
</script>