{#
 # Macro to generate common hidden input fields for forms
 # @param csrf_token string CSRF token value
 # @param id mixed Item ID value (can be empty string or integer)
 # @param authldap_id mixed AuthLDAP ID value (optional)
 # @param authldap_config object Configuration object with authldap_id property (optional)
 #}
{% macro hidden_form_inputs(csrf_token, id, authldap_id = null, authldap_config = null) %}
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="id" value="{{ id }}">
    {% if authldap_id %}
        <input type="hidden" name="authldap_id" value="{{ authldap_id }}">
    {% elseif authldap_config is defined and authldap_config.authldap_id is defined and authldap_config.authldap_id %}
        <input type="hidden" name="authldap_id" value="{{ authldap_config.authldap_id }}">
    {% endif %}
{% endmacro %}

{#
 # Macro to generate just the CSRF and ID hidden inputs (without authldap_id)
 # @param csrf_token string CSRF token value
 # @param id mixed Item ID value (can be empty string or integer)
 #}
{% macro base_hidden_inputs(csrf_token, id) %}
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="id" value="{{ id }}">
{% endmacro %}