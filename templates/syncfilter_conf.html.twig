{% import 'components/form/fields_macros.html.twig' as fields %}

{# Sync filter configuration #}
<div class="card-header">
    <h4 class="card-title">{{ __('LDAP Connections associated', 'advancedldap') }}</h4>
</div>
<div class="card-body">
    <div class="mt-3 mb-2">
        {% if available_authldaps is empty %}
            <div class="alert alert-warning">
                {{ __('No active LDAP connections available', 'advancedldap') }}
            </div>
        {% else %}
            <form method="post" action="{{ path('/plugins/advancedldap/front/authldapsyncfilter.form.php') }}" class="row g-3 align-items-end">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                <input type="hidden" name="syncfilter_id" value="{{ syncfilter_id }}">
                <div class="d-flex">
                    <div class="col-3">
                        {{ fields.dropdownArrayField(
                            'authldap_id',
                            '',
                            available_authldaps,
                            '',
                            {   
                                'no_label': true,
                                'required': true,
                                'display_emptychoice': true,
                                'emptylabel': __('Select an LDAP'),
                                'field_class' : 'col-12 pe-2'
                            }
                        ) }}
                    </div>
                    <div class="col-auto">
                        <button type="submit" name="add" class="btn btn-primary">
                            <i class="ti ti-link"></i> {{ __('Add', 'advancedldap') }}
                        </button>
                    </div>
                </div>
            </form>
        {% endif %}
    </div>
    {% if entries is not empty %}
        <h3 class="mt-2 mb-3">{{ __('Linked LDAP', 'advancedldap') }}</h3>
        {% include 'components/datatable.html.twig' with {
            'datatable_id': 'syncfilter_ldap_connections',
            'columns': {
                'name': __('Name'),
                'host': __('Server'),
                'port': __('Port'),
            },
            'formatters': {
                'name': 'raw_html',
            },
            'entries': entries,
            'total_number': entries|length,
            'filtered_number': entries|length,
            'showmassiveactions': true,
            'massiveactionparams': massiveactionparams,
            'nofilter': true,
        } only %}
    {% else %}
        <div class="alert alert-info mb-4">
            {{ __('No LDAP association linked to this sync filter', 'advancedldap') }}
        </div>
    {% endif %}
</div>

