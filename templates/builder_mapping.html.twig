<div class="card"
     id="builder-mapping"
     data-advancedldap-sections="{{ sections|json_encode|e('html_attr') }}"
     data-advancedldap-completions="{{ completions|default([])|json_encode|e('html_attr') }}"
     data-advancedldap-builder-itemtype="{{ builder_itemtype|e('html_attr') }}"
     data-advancedldap-csrf-token="{{ csrf_token() }}"
     data-advancedldap-i18n="{{ {
         confirm_section: __('Reset this section to default values?', 'advancedldap'),
         section_reset: __('Section reset to defaults', 'advancedldap'),
         section_reset_error: __('Failed to reset section', 'advancedldap'),
         confirm_all: __('Reset ALL sections to default values?', 'advancedldap'),
         all_reset: __('All sections reset to defaults', 'advancedldap'),
         all_reset_error: __('Failed to reset sections', 'advancedldap')
     }|json_encode|e('html_attr') }}">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-code me-2"></i>
            {{ __('JSON Builder Mapping', 'advancedldap') }}
        </h3>
        <div class="card-actions">
            <button type="button" class="btn btn-outline-warning btn-sm" id="reset-all-sections">
                <i class="ti ti-refresh me-1"></i>
                {{ __('Reset all to defaults', 'advancedldap') }}
            </button>
        </div>
    </div>
    <div class="card-body">
        {% if authldap_status is defined %}
            {% if not authldap_status.has_authldap %}
                <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <div>
                        {{ __('No LDAP connection linked to this SyncFilter. LDAP attributes autocomplete is not available.', 'advancedldap') }}
                    </div>
                </div>
            {% elseif not authldap_status.is_active %}
                <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <div>
                        {{ __('The linked LDAP connection "%s" is not active.', 'advancedldap')|format(authldap_status.authldap_name) }}
                    </div>
                </div>
            {% elseif not authldap_status.can_connect %}
                <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                    <i class="ti ti-alert-circle me-2"></i>
                    <div>
                        {{ __('Cannot connect to LDAP server "%s": %s', 'advancedldap')|format(authldap_status.authldap_name, authldap_status.error_message) }}
                    </div>
                </div>
            {% endif %}
        {% endif %}

        <form method="post" action="{{ config('root_doc') }}/plugins/advancedldap/front/buildermapping.form.php" id="builder-mapping-form">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="id" value="{{ builder.getID() }}">
            <input type="hidden" name="builder_itemtype" value="{{ builder_itemtype }}">

            {% for section in sections %}
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="mb-0">
                            <i class="ti ti-braces me-1"></i>
                            {{ section.name|capitalize }}
                        </h4>
                        <button type="button" class="btn btn-outline-secondary btn-sm reset-section" data-section="{{ section.name }}">
                            <i class="ti ti-refresh me-1"></i>
                            {{ __('Reset', 'advancedldap') }}
                        </button>
                    </div>
                    <div id="editor-{{ section.name }}" style="min-height: 80px; border: 1px solid var(--tblr-border-color); border-radius: var(--tblr-border-radius);"></div>
                    <input type="hidden" name="sections[{{ section.name }}]" id="input-{{ section.name }}" value="{{ section.content|e('html_attr') }}">
                </div>
            {% endfor %}

            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="submit" name="update" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>
                    {{ __('Save') }}
                </button>
            </div>
        </form>
    </div>
</div>

{{ call('Html::script', ['/plugins/advancedldap/js/builder_mapping.js', {'version': constant('PLUGIN_ADVANCEDLDAP_VERSION')}, false])|raw }}
