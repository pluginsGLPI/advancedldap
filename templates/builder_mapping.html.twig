{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-code me-2"></i>
            {{ __('JSON Builder Mapping', 'advancedldap') }}
        </h3>
        <div class="card-actions">
            <button type="button" class="btn btn-outline-warning btn-sm" id="reset-all-sections">
                <i class="ti ti-refresh me-1"></i>
                {{ __('Reset all to defaults', 'advancedldap') }}
            </button>
        </div>
    </div>
    <div class="card-body">
        {% if authldap_status is defined %}
            {% if not authldap_status.has_authldap %}
                <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <div>
                        {{ __('No LDAP connection linked to this SyncFilter. LDAP attributes autocomplete is not available.', 'advancedldap') }}
                    </div>
                </div>
            {% elseif not authldap_status.is_active %}
                <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                    <i class="ti ti-alert-triangle me-2"></i>
                    <div>
                        {{ __('The linked LDAP connection "%s" is not active.', 'advancedldap')|format(authldap_status.authldap_name) }}
                    </div>
                </div>
            {% elseif not authldap_status.can_connect %}
                <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                    <i class="ti ti-alert-circle me-2"></i>
                    <div>
                        {{ __('Cannot connect to LDAP server "%s": %s', 'advancedldap')|format(authldap_status.authldap_name, authldap_status.error_message) }}
                    </div>
                </div>
            {% endif %}
        {% endif %}

        <form method="post" action="{{ config('root_doc') }}/plugins/advancedldap/front/buildermapping.form.php" id="builder-mapping-form">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="id" value="{{ builder.getID() }}">
            <input type="hidden" name="builder_itemtype" value="{{ builder_itemtype }}">

            {% for section in sections %}
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="mb-0">
                            <i class="ti ti-braces me-1"></i>
                            {{ section.name|capitalize }}
                        </h4>
                        <button type="button" class="btn btn-outline-secondary btn-sm reset-section" data-section="{{ section.name }}">
                            <i class="ti ti-refresh me-1"></i>
                            {{ __('Reset', 'advancedldap') }}
                        </button>
                    </div>
                    <div id="editor-{{ section.name }}" style="height: 300px;"></div>
                    <input type="hidden" name="sections[{{ section.name }}]" id="input-{{ section.name }}" value="{{ section.content|e('html_attr') }}">
                </div>
            {% endfor %}

            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="submit" name="update" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>
                    {{ __('Save') }}
                </button>
            </div>
        </form>
    </div>
</div>

<script type="module">
    const sections = {{ sections|json_encode|raw }};
    const completions = {{ completions|default([])|json_encode|raw }};
    const editors = {};

    // Ensure Monaco module is loaded (needed for AJAX-loaded tabs)
    import(CFG_GLPI.root_doc + '/js/modules/Monaco/MonacoEditor.js').then(() => {
        sections.forEach((section) => {
            const containerId = `editor-${section.name}`;
            const inputId = `input-${section.name}`;

            window.GLPI.Monaco.createEditor(containerId, 'twig', section.content, completions).then((monaco) => {
                editors[section.name] = monaco;

                // Update hidden input on change
                monaco.editor.onDidChangeModelContent(() => {
                    document.getElementById(inputId).value = monaco.editor.getValue();
                });

                // Force layout after creation
                monaco.editor.layout();
            });
        });
    });

    // Handle form submission - sync editor values to hidden inputs
    $('#builder-mapping-form').on('submit', function(e) {
        sections.forEach((section) => {
            const inputId = `input-${section.name}`;
            if (editors[section.name]) {
                document.getElementById(inputId).value = editors[section.name].editor.getValue();
            }
        });
    });

    // Reset single section
    $('.reset-section').on('click', function() {
        const sectionName = $(this).data('section');
        if (!confirm('{{ __('Reset this section to default values?', 'advancedldap') }}')) {
            return;
        }

        $.ajax({
            url: '{{ config('root_doc') }}/plugins/advancedldap/ajax/buildermapping.php',
            method: 'POST',
            data: {
                action: 'get_default_section',
                section: sectionName,
                builder_itemtype: '{{ builder_itemtype|e('js') }}',
                _glpi_csrf_token: '{{ csrf_token() }}'
            },
            success: function(response) {
                if (response.success && editors[sectionName]) {
                    editors[sectionName].editor.setValue(response.content);
                    glpi_toast_info('{{ __('Section reset to defaults', 'advancedldap') }}');
                }
            },
            error: function() {
                glpi_toast_error('{{ __('Failed to reset section', 'advancedldap') }}');
            }
        });
    });

    // Reset all sections
    $('#reset-all-sections').on('click', function() {
        if (!confirm('{{ __('Reset ALL sections to default values?', 'advancedldap') }}')) {
            return;
        }

        $.ajax({
            url: '{{ config('root_doc') }}/plugins/advancedldap/ajax/buildermapping.php',
            method: 'POST',
            data: {
                action: 'get_all_default_sections',
                builder_itemtype: '{{ builder_itemtype|e('js') }}',
                _glpi_csrf_token: '{{ csrf_token() }}'
            },
            success: function(response) {
                if (response.success) {
                    for (const [sectionName, content] of Object.entries(response.sections)) {
                        if (editors[sectionName]) {
                            editors[sectionName].editor.setValue(content);
                        }
                    }
                    glpi_toast_info('{{ __('All sections reset to defaults', 'advancedldap') }}');
                }
            },
            error: function() {
                glpi_toast_error('{{ __('Failed to reset sections', 'advancedldap') }}');
            }
        });
    });
</script>
