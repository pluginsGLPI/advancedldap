{% import "components/form/fields_macros.html.twig" as fields %}
{% import "@advancedldap/macros/form_helpers.html.twig" as form_helpers %}

{# Breadcrumb navigation #}
{% if parent_authldap or current_authldap_id %}
    <div class="card mb-3">
        <div class="card-body py-2">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="{{ config('root_doc') }}/front/authldap.php">
                            <i class="ti ti-server me-1"></i>{{ 'AuthLDAP'|itemtype_name(2) }}
                        </a>
                    </li>
                    {% if parent_authldap %}
                        <li class="breadcrumb-item">
                            <a href="{{ config('root_doc') }}/front/authldap.form.php?id={{ parent_authldap.getID() }}&forcetab=AuthLDAP$main">
                                <i class="ti ti-settings me-1"></i>{{ parent_authldap.fields.name }}
                            </a>
                        </li>
                    {% elseif current_authldap_id %}
                        <li class="breadcrumb-item">
                            {{ get_item_link('AuthLDAP', current_authldap_id) }}
                        </li>
                    {% endif %}
                    <li class="breadcrumb-item active">
                        <i class="ti ti-filter me-1"></i>{{ __('Sync Filter', 'advancedldap') }}
                    </li>
                </ol>
            </nav>
        </div>
    </div>
{% endif %}

{# Warning for inventory not enabled #}
{% if not inventory_enabled %}
    <div class="alert alert-warning d-flex align-items-center mb-3">
        <i class="ti ti-alert-triangle me-2"></i>
        <div>
            <strong>{{ __('Warning', 'advancedldap') }}:</strong>
            {{ __('GLPI Inventory is not enabled. Synchronization using the Inventory class will not work.', 'advancedldap') }}
            <a href="{{ inventory_config_url }}" class="alert-link ms-2" target="_blank">
                <i class="ti ti-settings me-1"></i>{{ __('Enable it in the Inventory configuration', 'advancedldap') }}
            </a>
        </div>
    </div>
{% endif %}

{# Warning for inactive LDAP server #}
{% if authldap_active_status and not authldap_active_status.is_active %}
    <div class="alert alert-warning d-flex align-items-center mb-3">
        <i class="ti ti-alert-triangle me-2"></i>
        <div>
            <strong>{{ __('Warning', 'advancedldap') }}:</strong>
            {{ __('The LDAP server', 'advancedldap') }}
            {% if authldap_active_status.server_name %}
                "<strong>{{ authldap_active_status.server_name|e('html') }}</strong>"
            {% endif %}
            {{ __('is currently inactive. Synchronization will not work until the server is activated.', 'advancedldap') }}
            {% if current_authldap_id %}
                <a href="{{ config('root_doc') }}/front/authldap.form.php?id={{ current_authldap_id }}" class="alert-link ms-2" target="_blank">
                    <i class="ti ti-settings me-1"></i>{{ __('Activate the LDAP server', 'advancedldap') }}
                </a>
            {% endif %}
        </div>
    </div>
{% endif %}

{# Warning for LDAP connection issues #}
{% if ldap_connection_status and not ldap_connection_status.connected %}
    <div class="alert alert-danger d-flex align-items-center mb-3">
        <i class="ti ti-alert-circle me-2"></i>
        <div>
            <strong>{{ __('LDAP Connection Error', 'advancedldap') }}:</strong>
            {% if ldap_connection_status.server_name %}
                {{ __('Server', 'advancedldap') }} "<strong>{{ ldap_connection_status.server_name|e('html') }}</strong>":
            {% endif %}
            {{ ldap_connection_status.error|e('html') }}
            {% if current_authldap_id %}
                <a href="{{ config('root_doc') }}/front/authldap.form.php?id={{ current_authldap_id }}" class="alert-link ms-2" target="_blank">
                    <i class="ti ti-settings me-1"></i>{{ __('Check LDAP server configuration', 'advancedldap') }}
                </a>
            {% endif %}
        </div>
    </div>
{% endif %}

<form method="post" action="{{ config('root_doc') }}/plugins/advancedldap/front/syncfilter.form.php" data-submit-once="true">
<div class="card">
    <div class="card-header d-flex align-items-center">
        <h3 class="mb-0">{{ item.isNewID(item.getID()) ? __('New Sync Filter', 'advancedldap') : __('Edit Sync Filter', 'advancedldap') }}</h3>
    </div>
    <div class="card-body">
        <!-- AuthLDAP Server Information -->
        {% if parent_authldap %}
            <div class="alert alert-info d-flex align-items-center mb-3">
                <i class="ti ti-info-circle me-2"></i>
                <div>
                    <strong>{{ __('Parent AuthLDAP Server:', 'advancedldap') }}</strong>
                    <a href="{{ config('root_doc') }}/front/authldap.form.php?id={{ parent_authldap.getID() }}&forcetab=AuthLDAP$main" class="alert-link ms-2">
                        <i class="ti ti-external-link me-1"></i>{{ parent_authldap.fields.name }}
                    </a>
                </div>
            </div>
        {% elseif current_config.authldap_id %}
            <div class="alert alert-info d-flex align-items-center mb-3">
                <i class="ti ti-info-circle me-2"></i>
                <div>
                    <strong>{{ __('AuthLDAP Server:', 'advancedldap') }}</strong>
                    {{ get_item_link('AuthLDAP', current_config.authldap_id) }}
                </div>
            </div>
        {% endif %}
        <!-- First row: Filter Name and Active Filter -->
        <div class="row">
            <div class="col-md-6">
                <div class="form-field mb-3">
                    <label class="form-label"><i class="ti ti-tag me-1"></i>{{ __('Filter Name', 'advancedldap') }}</label>
                    <input type="text" name="name" class="form-control" 
                           value="{{ current_config.filter_name|default(item.fields['name']|default('')) }}"
                           placeholder="{{ __('Enter a name for this sync filter', 'advancedldap') }}">
                    <div class="form-text">{{ __('Give a descriptive name to this synchronization filter', 'advancedldap') }}</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-field mb-3">
                    <label class="form-label">{{ __('Active Filter', 'advancedldap') }}</label>
                    {{ fields.sliderField('is_active', current_config.is_active|default(item.fields['is_active']|default(0)), '', {
                        'no_label': true,
                        'helper': __('Enable or disable this synchronization filter', 'advancedldap')
                    }) }}
                </div>
            </div>
        </div>


        <!-- Second row: Base DN and LDAP Connection Filter -->
        <div class="row">
            <div class="col-md-6">
                <div class="form-field mb-3">
                    <label class="form-label"><i class="ti ti-binary-tree me-1"></i>{{ __('Base DN', 'advancedldap') }}</label>
                    <input type="text" name="base_dn" class="form-control" 
                           value="{{ current_config.ldap_base_dn|default(item.fields['base_dn']|default('')) }}" 
                           placeholder="ou=computers,dc=example,dc=com">
                    <div class="form-text">{{ __('Base Distinguished Name for LDAP synchronization (e.g., ou=computers,dc=example,dc=com)', 'advancedldap') }}</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-field mb-3">
                    <label class="form-label"><i class="ti ti-filter me-1"></i>{{ __('LDAP Connection Filter', 'advancedldap') }}</label>
                    <input type="text" name="ldap_filter" class="form-control" 
                           value="{{ current_config.ldap_connection_filter|default(item.fields['ldap_filter']|default('')) }}" 
                           placeholder="(&(objectClass=device)(serialNumber=*))">
                    <div class="form-text">{{ __('LDAP filter for synchronization (e.g., (&(objectClass=device)(serialNumber=*)))', 'advancedldap') }}</div>
                </div>
            </div>
        </div>
        
        <!-- Third row: Asset Type and Asset Field -->
        <div class="row mt-3">
            <div class="col-md-6">
                <div class="form-field mb-3">
                    <label class="form-label"><i class="ti ti-package me-1"></i>{{ __('Asset Type') }}</label>
                    {% set asset_type_rand = random() %}
                    <select name="asset_type" id="dropdown_asset_type{{ asset_type_rand }}" class="form-select">
                        <option value="">{{ __('Select an asset type') }}</option>
                        {% for key, value in available_assets %}
                            {% if key in ['native_separator', 'generic_separator'] %}
                                <option disabled>{{ value }}</option>
                            {% else %}
                                <option value="{{ key }}" {% if key == current_config.asset_type %}selected{% endif %}>{{ value }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-field mb-3">
                    <label class="form-label"><i class="ti ti-link me-1"></i>{{ __('Fields Mapping', 'advancedldap') }}</label>
                    <div class="alert alert-info d-flex align-items-center">
                        <i class="ti ti-info-circle me-2"></i>
                        <div>
                            {{ __('Configure the mapping between GLPI asset fields and LDAP attributes in the dedicated tab.', 'advancedldap') }}
                            {% if item.fields['id'] > 0 %}
                                <a href="{{ config('root_doc') }}/plugins/advancedldap/front/syncfilter.form.php?id={{ item.fields['id'] }}&forcetab=GlpiPlugin\Advancedldap\Models\SyncFilter$1" class="alert-link ms-2">
                                    <i class="ti ti-arrow-right me-1"></i>{{ __('Go to Fields Mapping tab', 'advancedldap') }}
                                </a>
                            {% else %}
                                <br>
                                <small class="text-muted">{{ __('Save this filter first to access the fields mapping configuration.', 'advancedldap') }}</small>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="ms-auto">
            {{ form_helpers.hidden_form_inputs(csrf_token(), item.fields['id'], current_authldap_id, current_config) }}
            
            {% if item.fields['id'] > 0 and item.canPurge() %}
                <button type="submit" name="purge" class="btn btn-outline-danger me-2"
                        onclick="return confirm('{{ __('Confirm the final deletion?', 'advancedldap') }}')">
                    <i class="ti ti-trash"></i>
                    <span>{{ __('Delete permanently') }}</span>
                </button>
            {% endif %}

            {% if item.fields['id'] > 0 %}
                {% set test_url = config('root_doc') ~ '/plugins/advancedldap/front/syncfilter.form.php?id=' ~ item.fields['id'] ~ '&test_ldap=1' %}
                {% if current_authldap_id %}
                    {% set test_url = test_url ~ '&authldap_id=' ~ current_authldap_id %}
                {% endif %}
                <a href="{{ test_url }}" class="btn btn-info me-2">
                    <i class="ti ti-test-pipe"></i>
                    <span>{{ __('Test LDAP Filter', 'advancedldap') }}</span>
                </a>
            {% endif %}

            <button type="submit" name="{{ item.isNewID(item.getID()) ? 'add' : 'update' }}" class="btn btn-primary me-2">
                <i class="fas fa-save"></i>
                <span>{{ item.isNewID(item.getID()) ? __('Add') : __('Update') }}</span>
            </button>

            {% if item.fields['id'] > 0 %}
                <div class="form-text text-info mt-2">
                    <i class="ti ti-info-circle me-1"></i>{{ __('Save your changes before testing to ensure accurate results', 'advancedldap') }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
</form>

{% if test_results %}
<div class="card mt-3">
    <div class="card-header bg-info text-white">
        <h4><i class="ti ti-test-pipe me-2"></i>{{ __('LDAP Filter Test Results', 'advancedldap') }}</h4>
    </div>
    <div class="card-body">
        {% if test_results.error %}
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>{{ __('Error:', 'advancedldap') }}</strong> {{ test_results.error|e('html') }}
            </div>
        {% else %}
            
            <!-- Résultats LDAP -->
            <div class="alert alert-success d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fas fa-check-circle me-2"></i>{{ test_results.entries|length }} {{ __('entries found in LDAP', 'advancedldap') }}</h5>
                <form method="post" action="{{ config('root_doc') }}/plugins/advancedldap/front/syncfilter.form.php" class="d-inline">
                    {{ form_helpers.hidden_form_inputs(csrf_token(), item.fields['id'], current_authldap_id, current_config) }}
                    <input type="hidden" name="sync_from_ldap" value="1">
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="fas fa-sync-alt me-1"></i>{{ __('Sync data from LDAP directory', 'advancedldap') }}
                    </button>
                </form>
            </div>
            
            {% if test_results.entries|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>{{ __('LDAP DN', 'advancedldap') }}</th>
                                <th>{{ __('LDAP Attributes', 'advancedldap') }}</th>
                                <th>{{ __('GLPI Impact', 'advancedldap') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for entry in test_results.entries %}
                                <tr>
                                    <td><code>{{ entry.dn|e('html') }}</code></td>
                                    <td>
                                        {% for attr, values in entry.attributes %}
                                            <div><strong>{{ attr|e('html') }}:</strong>
                                                {% if values is iterable %}
                                                    {{ values|join(', ')|e('html') }}
                                                {% else %}
                                                    {{ values|e('html') }}
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </td>
                                    <td>
                                        {% if entry.glpi_impact.exists %}
                                            <span class="badge bg-warning">{{ __('Update existing', 'advancedldap') }}</span>
                                        {% else %}
                                            <span class="badge bg-info">{{ __('Create new', 'advancedldap') }}</span>
                                        {% endif %}
                                        <div class="mt-1">
                                            {{ entry.glpi_impact.message|e('html') }}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endif %}

<script type="text/javascript">
$(document).ready(function() {
    // Check if we need to open the Fields Mapping tab
    if (window.location.hash === '#open-fields-mapping') {
        // Wait a bit for tabs to be fully loaded
        setTimeout(function() {
            // Try to find and click the Fields Mapping tab
            var foundTab = false;

            // First try: Look for tabs with the exact text
            $('a[data-bs-toggle="tab"]').each(function() {
                if ($(this).text().includes('Fields mapping')) {
                    $(this).tab('show');
                    foundTab = true;
                    return false; // break the loop
                }
            });

            // Second try: Look in the navigation tabs
            if (!foundTab) {
                $('#tabspanel .nav-link').each(function() {
                    if ($(this).text().includes('Fields mapping')) {
                        $(this).click();
                        foundTab = true;
                        return false;
                    }
                });
            }

            // Clear the hash after switching
            if (foundTab) {
                history.replaceState(null, null, window.location.pathname + window.location.search);
            }
        }, 500);
    }

    // Disable Test LDAP Filter button when form fields are modified
    var testLdapButton = $('a.btn.btn-info[href*="test_ldap"]');
    if (testLdapButton.length > 0) {
        var watchedFields = [
            'input[name="base_dn"]',
            'input[name="ldap_filter"]',
            'select[name="asset_type"]'
        ];

        // Store initial values
        var initialValues = {};
        watchedFields.forEach(function(selector) {
            var field = $(selector);
            if (field.length > 0) {
                initialValues[selector] = field.val();
            }
        });

        // Function to check if any field has been modified
        function checkFieldsModified() {
            var isModified = false;
            watchedFields.forEach(function(selector) {
                var field = $(selector);
                if (field.length > 0 && field.val() !== initialValues[selector]) {
                    isModified = true;
                }
            });


            if (isModified) {
                testLdapButton.css({
                    'opacity': '0.5',
                    'cursor': 'not-allowed',
                    'pointer-events': 'none'
                });
            } else {
                testLdapButton.css({
                    'opacity': '1',
                    'cursor': 'pointer',
                    'pointer-events': 'auto'
                });
            }
        }

        // Watch for changes on static fields
        watchedFields.forEach(function(selector) {
            $(document).on('change', selector, checkFieldsModified);
        });

        // Prevent click on disabled button
        testLdapButton.on('click', function(e) {
            if ($(this).hasClass('disabled')) {
                e.preventDefault();
                displayAjaxMessageAfterRedirect({
                    message: '{{ __("Please save your changes before testing the LDAP filter", "advancedldap")|e('js') }}',
                    type: 'warning',
                    timeout: 3000
                });
                return false;
            }
        });
    }
});
</script>