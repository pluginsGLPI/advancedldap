<div class="card">
    <div class="card-body">
        {% if not itemtype %}
            <div class="alert alert-warning">
                <i class="ti ti-alert-triangle me-2"></i>
                {{ __('Please select an asset type in the main configuration tab first', 'advancedldap') }}
            </div>
        {% else %}
            <div class="alert alert-info mb-3">
                <i class="ti ti-info-circle me-2"></i>
                {{ __('Configure the mapping between GLPI asset fields and LDAP attributes. These mappings can be saved from this tab or from the main configuration tab.', 'advancedldap') }}
            </div>

            <div id="field-mappings-container">
                {% set index = 0 %}
                {% for mapping in current_mappings %}
                    <div class="field-mapping-row mb-3" data-index="{{ index }}">
                        <div class="row align-items-center">
                            {# GLPI field select #}
                            <div class="col-md-5">
                                <div id="glpi-field-dropdown-{{ index }}" data-selected="{{ mapping.glpi_field|default('') }}">
                                    {# Will be populated by AJAX #}
                                </div>
                            </div>

                            {# Arrow icon #}
                            <div class="col-md-1 text-center">
                                <i class="ti ti-arrow-right"></i>
                            </div>

                            {# LDAP attribute input #}
                            <div class="col-md-5">
                                <input type="text"
                                       class="form-control ldap-attribute-input"
                                       placeholder="{{ __('LDAP attribute (e.g., cn, serialNumber)', 'advancedldap') }}"
                                       value="{{ mapping.ldap_attr|default('')|e('html_attr') }}"
                                       data-index="{{ index }}"
                                       {% if not mapping.glpi_field %}style="display: none;"{% endif %}>
                            </div>

                            {# Remove button #}
                            <div class="col-md-1">
                                <button type="button"
                                        class="btn btn-sm btn-ghost-danger remove-mapping-row"
                                        data-index="{{ index }}"
                                        title="{{ __('Remove mapping', 'advancedldap') }}"
                                        {% if not mapping.glpi_field %}style="display: none;"{% endif %}>
                                    <i class="ti ti-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    {% set index = index + 1 %}
                {% endfor %}
            </div>

            {# Hidden input that will be updated by JavaScript and included in form submission #}
            <input type="hidden" id="field_mappings_json" name="field_mappings" value="">

            {# Save button positioned at bottom right #}
            <div class="mt-3 text-end">
                <button type="button" id="save-mappings-btn" class="btn btn-primary">
                    <i class="ti ti-device-floppy me-2"></i>{{ __('Save mappings', 'advancedldap') }}
                </button>
            </div>
        {% endif %}
    </div>
</div>

{% if itemtype %}
<script type="text/javascript">
    // Configuration for field mapping JavaScript
    window.ADVANCEDLDAP_FIELD_MAPPING_CONFIG = {
        currentMappings: {{ current_mappings|json_encode|raw }},
        itemtype: '{{ itemtype|e('js') }}',
        syncfilterId: {{ syncfilter_id|default(0) }},
        csrfToken: '{{ _glpi_csrf_token|e('js') }}'
    };

    // Initialize field mapping when jQuery is ready and the container exists
    jQuery(function($) {
        if ($('#field-mappings-container').length && window.AdvancedLdapFieldMapping) {
            window.AdvancedLdapFieldMapping.init(window.ADVANCEDLDAP_FIELD_MAPPING_CONFIG);
        }
    });
</script>
{% endif %}
