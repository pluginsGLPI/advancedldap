{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="card-header">
    <h4 class="card-title mb-0">{{ title }}</h4>
</div>
<div class="card-body">
    <div class="mt-3 mb-2">
        <form method="post" action="{{ form_url }}" class="row g-3 align-items-end">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="{{ parent_field_name }}" value="{{ parent_id }}">
            <div class="d-flex">
                <div class="col-3">
                    {{ fields.dropdownArrayField(
                        dropdown_field_name,
                        '',
                        available_items,
                        '',
                        {
                            'no_label': true,
                            'required': true,
                            'display_emptychoice': false,
                            'field_class': 'col-12 pe-2',
                            'add_field_attribs': {
                                'data-relation-dropdown': 'true'
                            }
                        }
                    ) }}
                </div>
                <div class="col-auto">
                    <button type="submit" name="add" id="relation-add-button" class="btn btn-primary" >
                        <i class="ti ti-link"></i> {{ __('Add', 'advancedldap') }}
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
